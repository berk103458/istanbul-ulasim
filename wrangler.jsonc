{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "istanbul-ulasim",
  "main": "worker.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"],
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
